{
  "name": "wizard1v1",
  "version": "0.2.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "dev": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "local:web": "expo export --platform web --output-dir android/app/src/main/assets/local-web",
    "local:serve": "node tools/local-multiplayer/serve.cjs",
    "android:build": "expo run:android",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && expo export --platform all",
    "test": "vitest run",
    "balance": "node tools/balance-lab/run.cjs",
    "balance:test": "node --test tools/balance-lab/checks.cjs",
    "docs:generate": "node tools/refresh-spell-reference.cjs",
    "docs:check": "node tools/refresh-spell-reference.cjs --check"
  },
  "dependencies": {
    "expo": "~57.0.24",
    "expo-screen-orientation": "~57.0.2",
    "expo-status-bar": "~57.0.1",
    "qrcode-generator": "^2.0.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.2"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "esbuild": "^0.28.2",
    "typescript": "~6.0.3",
    "vitest": "^3.2.7"
  }
